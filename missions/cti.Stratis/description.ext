// Phase-1 Stratis mission. Thin by design (ADR-0007): slots, a manifest
// reference and nothing else — every rule lives in the cti addon.
briefingName = "arma-cti — Stratis";
onLoadName = "arma-cti — Stratis";
author = "arma-cti";

class Header
{
    gameType = "CTI";
    minPlayers = 1;
    maxPlayers = 3; // the playable roles in mission.sqm: two Commanders plus HC1
};

briefing = 0;
debriefing = 0;

respawn = "BASE";
respawnDelay = 5;
respawnDialog = 0;
disabledAI = 1;
joinUnassigned = 1;
enableDebugConsole = 1;

// A joining client takes the first free role instead of stopping at role
// selection. The server initialises the mission itself (-autoInit, which needs
// persistent = 1 and this respawn type), so there is a running mission to be
// dropped into — which is the case this setting describes and the case a
// headless client already benefits from.
skipLobby = 1;

// The Command Port is the only order path (ADR-0012). The engine default is
// mode = 2, fully open, and shipping that would silently void the guarantee.
//
// Both classes are locked. A mission that sets only Functions leaves Commands
// at the open default, which is a hole the size of the whole scripting-command
// surface. The rules bind clients only; the server stays unrestricted, which is
// how it still routes judgements back with cti_fnc_portReply — deliberately not
// whitelisted here, so no client can call it on another.
class CfgRemoteExec
{
    class Functions
    {
        mode = 1;
        jip = 0;
        // allowedTargets = 2: clients may call this on the server and nowhere
        // else. jip = 0: a Command is a decision at a moment, never replayed
        // to a machine that joined later.
        class cti_fnc_portGateway
        {
            allowedTargets = 2;
            jip = 0;
        };
    };

    class Commands
    {
        mode = 1;
    };
};

// The map this mission is played on. The addon looks its manifest up by
// worldName, so this is a cross-check rather than the lookup itself: if the two
// disagree, the mission was copied to a map its manifest was never authored for.
cti_manifest_map = "stratis";
